# ================= BACKEND SETTINGS =================

# Port when running on your computer
PORT=4000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/rotaract-butwal-synergy?retryWrites=true&w=majority

# Cloudinary (image uploads) — from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Secret used to sign admin logins (at least 32 random characters)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Shared secret between frontend and backend (SAME value in both projects)
# Generate it the same way as JWT_SECRET (use a different value)
INTERNAL_SECRET=

# First admin account — only used on the very first login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-Strong-123

# Address of the FRONTEND website (no trailing slash). Several allowed: comma separated
FRONTEND_URL=http://localhost:3000
